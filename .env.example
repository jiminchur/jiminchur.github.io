# Copy to .env.local for local development.
# On Vercel, set these under Settings → Environment Variables.

# Canonical origin, used by metadataBase / sitemap.xml / robots.txt.
# Leave unset on Vercel to fall back to VERCEL_PROJECT_PRODUCTION_URL;
# set it explicitly once a custom domain is attached.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (Admin → Data Streams). Format: G-XXXXXXXXXX
# Analytics is skipped entirely when this is empty, so local runs stay clean.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token — the `content` value only,
# not the whole <meta> tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
